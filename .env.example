# Public site URL (no trailing slash). Used for PayOS return/cancel URLs.
APP_URL=http://localhost:3000

# Supabase: server-side service-role key only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# PayOS credentials from the payment channel dashboard.
PAYOS_CLIENT_ID=replace-me
PAYOS_API_KEY=replace-me
PAYOS_CHECKSUM_KEY=replace-me

# Resend transactional-email configuration for email OTPs.
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Moc Xinh <no-reply@your-domain.vn>

# Random secrets: use a different, long random value for each one.
OTP_HASH_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-different-long-random-secret

# The seeded workshop slug in supabase/workshop-payments.sql. Do not expose secret keys here.
WORKSHOP_SLUG=moc-xinh-fall-2026
